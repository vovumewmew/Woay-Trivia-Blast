# ==============================================
# QUẢN LÝ THƯ VIỆN (DEPENDENCIES)
# ==============================================
# Thư mục chứa hàng ngàn file thư viện tải về - Tuyệt đối không commit
node_modules/
.pnp
.pnp.js

# ==============================================
# MÔI TRƯỜNG & BẢO MẬT (QUAN TRỌNG)
# ==============================================
# Chứa API Key, Port, Password DB... - Tuyệt đối không commit
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# ==============================================
# FILE ĐÓNG GÓI (BUILD OUTPUT)
# ==============================================
# Kết quả sau khi chạy 'npm run build' (Vite tạo dist, CRA tạo build)
build/
dist/

# ==============================================
# LOGS & DEBUG
# ==============================================
# File báo lỗi khi chạy npm/yarn
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ==============================================
# FILE RÁC HỆ ĐIỀU HÀNH (OS FILES)
# ==============================================
# File sinh ra bởi Mac/Windows
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ==============================================
# CẤU HÌNH IDE/EDITOR (MÁY CÁ NHÂN)
# ==============================================
# Cấu hình riêng của VS Code hoặc WebStorm
.idea/
.vscode/
*.swp
*.swo

# --- Ngoại lệ (Exceptions) ---
# Giữ lại file gợi ý extension để cả team cùng cài giống nhau
!.vscode/extensions.json

# ==============================================
# TÀI LIỆU & SƠ ĐỒ (DOCUMENTATION)
# ==============================================
# Thư mục output ảnh của PlantUML
out/

# Thư mục chứa báo cáo Word/PDF nặng (nếu không muốn đẩy lên Git)
Document/
*.docx
*.pdf

# File cấu trúc cây thư mục (nếu chỉ dùng để xem)
tree.txt

# ==============================================
# KHÁC (MISC)
# ==============================================
# File tiến trình chạy ngầm (thường thấy ở backend)
pid
pids
*.pid
*.seed
*.pid.lock

# Thư mục coverage khi chạy test
coverage/
.nyc_output/

.env