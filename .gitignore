# --- Testing ---
coverage/
.nyc_output/

# --- Production Build (File đóng gói) ---
build/
dist/

# --- Environment Variables (BẢO MẬT - Không bao giờ commit file này) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# --- Logs ---
logs
*.log
npm-debug.log*
yarn-debug.log*
